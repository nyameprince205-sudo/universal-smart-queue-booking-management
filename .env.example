# Copy this file to .env and fill in real values.
# In VS Code: right-click in the Explorer panel > New File > type ".env" exactly.

# MySQL connection string Prisma uses
DATABASE_URL="mysql://root:yourpassword@localhost:3306/queue_saas"

# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Paystack (Phase 6 — not needed yet)
PAYSTACK_SECRET_KEY=
