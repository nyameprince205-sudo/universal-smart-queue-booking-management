// ============================================================
// Universal Smart Queue & Booking Management System
// Prisma Schema — mirrors schema.sql
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// 1. PLATFORM & IDENTITY
// ------------------------------------------------------------

model BusinessType {
  id            Int            @id @default(autoincrement())
  name          String         @unique @db.VarChar(100)
  description   String?        @db.VarChar(255)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  organizations Organization[]

  @@map("business_types")
}

model Organization {
  id               BigInt      @id @default(autoincrement())
  uuid             String      @unique @db.Char(36)
  businessTypeId   Int         @map("business_type_id")
  name             String      @db.VarChar(150)
  slug             String      @unique @db.VarChar(150)
  email            String      @unique @db.VarChar(150)
  phone            String?     @db.VarChar(30)
  logoUrl          String?     @map("logo_url") @db.VarChar(255)
  status           OrgStatus   @default(trial)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  
  description   String?  @db.VarChar(500)
  whatsapp      String?  @db.VarChar(30)
  website       String?  @db.VarChar(255)
  facebook      String?  @db.VarChar(255)
  instagram     String?  @db.VarChar(255)
  openingHours  String?  @map("opening_hours") @db.VarChar(500)


  businessType         BusinessType          @relation(fields: [businessTypeId], references: [id])
  settings             OrganizationSettings?
  branches             Branch[]
  users                User[]
  customerOrganizations CustomerOrganization[]
  services             Service[]
  bookings             Booking[]
  serviceCounters      ServiceCounter[]
  queueTickets         QueueTicket[]
  subscriptions        Subscription[]
  payments             Payment[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  organizationRequests OrganizationRequest[]
  supportTickets       SupportTicket[]

  @@index([status])
  @@map("organizations")
}

enum OrgStatus {
  trial
  active
  suspended
  cancelled
}

model OrganizationSettings {
  id                    BigInt   @id @default(autoincrement())
  organizationId        BigInt   @unique @map("organization_id")
  queuePrefix           String   @default("Q") @map("queue_prefix") @db.VarChar(5)
  timezone              String   @default("Africa/Accra") @db.VarChar(50)
  bookingRules          Json?    @map("booking_rules")
  notificationSettings  Json?    @map("notification_settings")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model Branch {
  id              BigInt       @id @default(autoincrement())
  organizationId  BigInt       @map("organization_id")
  name            String       @db.VarChar(150)
  address         String?      @db.VarChar(255)
  phone           String?      @db.VarChar(30)
  timezone        String?      @db.VarChar(50)
  status          BranchStatus @default(active)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users           User[]
  services        Service[]
  bookings        Booking[]
  serviceCounters ServiceCounter[]
  queueTickets    QueueTicket[]

  @@unique([organizationId, name], name: "uq_branch_org_name")
  @@index([organizationId])
  @@map("branches")
}

enum BranchStatus {
  active
  inactive
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique @db.VarChar(50)
  description     String?          @db.VarChar(255)
  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique @db.VarChar(100)
  description     String?          @db.VarChar(255)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id             BigInt     @id @default(autoincrement())
  uuid           String     @unique @db.Char(36)
  organizationId BigInt?    @map("organization_id")
  branchId       BigInt?    @map("branch_id")
  roleId         Int        @map("role_id")
  name           String     @db.VarChar(150)
  email          String     @unique @db.VarChar(150)
  phone          String?    @db.VarChar(30)
  passwordHash   String     @map("password_hash") @db.VarChar(255)
  status         UserStatus @default(active)
  emailVerified  Boolean    @default(true) @map("email_verified")
  passwordChangedAt DateTime? @map("password_changed_at")
  lastLoginAt    DateTime?  @map("last_login_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  role         Role          @relation(fields: [roleId], references: [id])
  handledQueueTickets QueueTicket[]
  auditLogs    AuditLog[]
  reviewedOrgRequests OrganizationRequest[]
  
  @@index([organizationId])
  @@index([branchId])
  @@map("users")
  assignedCounter ServiceCounter? @relation("CounterAssignee")
  staffServices StaffService[]
}

enum UserStatus {
  active
  inactive
  suspended
}

// ------------------------------------------------------------
// 2. CUSTOMERS
// ------------------------------------------------------------

model Customer {
  id           BigInt         @id @default(autoincrement())
  uuid         String         @unique @db.Char(36)
  name         String         @db.VarChar(150)
  phone        String         @unique @db.VarChar(30)
  email        String?        @db.VarChar(150)
  passwordHash String?        @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime? @map("password_changed_at")
  status       CustomerStatus @default(active)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  customerOrganizations CustomerOrganization[]
  bookings              Booking[]
  queueTickets          QueueTicket[]

  @@map("customers")
}

enum CustomerStatus {
  active
  blocked
}

model CustomerOrganization {
  id                  BigInt        @id @default(autoincrement())
  customerId          BigInt        @map("customer_id")
  organizationId      BigInt        @map("organization_id")
  firstInteractionAt  DateTime      @map("first_interaction_at")
  lastInteractionAt   DateTime      @map("last_interaction_at")
  totalBookings       Int           @default(0) @map("total_bookings")
  status              CustomerOrgStatus @default(active)

  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([customerId, organizationId], name: "uq_customer_org")
  @@index([organizationId])
  @@map("customer_organizations")
}

enum CustomerOrgStatus {
  active
  blacklisted
}

// ------------------------------------------------------------
// 3. SERVICES & BOOKINGS
// ------------------------------------------------------------

model Service {
  id               BigInt   @id @default(autoincrement())
  organizationId   BigInt   @map("organization_id")
  branchId         BigInt?  @map("branch_id")
  name             String   @db.VarChar(150)
  description      String?  @db.VarChar(255)
  durationMinutes  Int      @default(30) @map("duration_minutes")
  // Max bookings accepted for the same date AND time. Null = unlimited,
  // which is what every service created before this feature has, so their
  // behaviour is unchanged.
  capacityPerSlot  Int?     @map("capacity_per_slot")
  // What happens when capacity_per_slot is reached. waitlist suits short
  // appointments (bank, clinic); reject suits day-long or single-item
  // bookings (hotel room, a specific table) where waiting helps nobody.
  whenFull         WhenFullBehaviour @default(waitlist) @map("when_full")
  price            Decimal? @db.Decimal(10, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  bookings     Booking[]
  queueTickets QueueTicket[]
  staffServices StaffService[]

  @@index([organizationId, isActive])
  @@map("services")
}

model Booking {
  id             BigInt        @id @default(autoincrement())
  uuid           String        @unique @db.Char(36)
  organizationId BigInt        @map("organization_id")
  branchId       BigInt        @map("branch_id")
  customerId     BigInt        @map("customer_id")
  serviceId      BigInt        @map("service_id")
  bookingDate    DateTime      @map("booking_date") @db.Date
  bookingTime    DateTime      @map("booking_time") @db.Time(0)
  partySize      Int           @default(1) @map("party_size")
  status         BookingStatus @default(pending)
  notes          String?       @db.VarChar(500)
  deletedAt      DateTime?     @map("deleted_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  service      Service       @relation(fields: [serviceId], references: [id])
  queueTickets QueueTicket[]

  @@index([organizationId, bookingDate, status])
  @@index([customerId])
  @@index([serviceId, bookingDate, bookingTime, status])
  @@map("bookings")
}

enum BookingStatus {
  pending
  confirmed
  checked_in
  cancelled
  completed
  no_show
  // Appended, never inserted mid-list: MySQL stores enums by ordinal
  // position, so inserting here would silently reassign every existing row.
  waitlisted
}

// ------------------------------------------------------------
// 4. QUEUE ENGINE
// ------------------------------------------------------------

model ServiceCounter {
  id             BigInt        @id @default(autoincrement())
  organizationId BigInt        @map("organization_id")
  branchId       BigInt        @map("branch_id")
  name           String        @db.VarChar(100)
  status         CounterStatus @default(closed)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  queueTickets QueueTicket[]
  assignedUserId BigInt?  @unique @map("assigned_user_id")
  assignedUser   User?    @relation("CounterAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@unique([branchId, name], name: "uq_counter_branch_name")
  @@map("service_counters")
}

enum CounterStatus {
  open
  closed
  brk @map("break")
}

model QueueTicket {
  id             BigInt      @id @default(autoincrement())
  uuid           String      @unique @db.Char(36)
  organizationId BigInt      @map("organization_id")
  branchId       BigInt      @map("branch_id")
  bookingId      BigInt?     @map("booking_id")
  customerId     BigInt      @map("customer_id")
  serviceId      BigInt      @map("service_id")
  counterId      BigInt?     @map("counter_id")
  handledByUserId BigInt?  @map("handled_by_user_id")
  queueDate      DateTime    @map("queue_date") @db.Date
  ticketNumber   String      @map("ticket_number") @db.VarChar(20)
  priority       Int         @default(0) @db.UnsignedTinyInt
  status         QueueStatus @default(waiting)
  createdAt      DateTime    @default(now()) @map("created_at")
  calledAt       DateTime?   @map("called_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch          @relation(fields: [branchId], references: [id])
  booking      Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customer     Customer        @relation(fields: [customerId], references: [id])
  service      Service         @relation(fields: [serviceId], references: [id])
  counter      ServiceCounter? @relation(fields: [counterId], references: [id], onDelete: SetNull)
  handledByUser User? @relation(fields: [handledByUserId], references: [id], onDelete: SetNull)
  history      QueueHistory?

  @@unique([organizationId, branchId, queueDate, ticketNumber], name: "uq_ticket_per_branch_day")
  @@index([organizationId, branchId, status])
  @@map("queue_tickets")
}

enum QueueStatus {
  waiting
  called
  serving
  completed
  cancelled
}

model QueueHistory {
  id                  BigInt    @id @default(autoincrement())
  queueTicketId       BigInt    @unique @map("queue_ticket_id")
  enteredQueueAt      DateTime  @map("entered_queue_at")
  calledAt            DateTime? @map("called_at")
  serviceStartAt      DateTime? @map("service_start_at")
  completedAt         DateTime? @map("completed_at")
  waitTimeSeconds     Int?      @map("wait_time_seconds")
  serviceTimeSeconds  Int?      @map("service_time_seconds")

  queueTicket QueueTicket @relation(fields: [queueTicketId], references: [id], onDelete: Cascade)

  @@map("queue_history")
}

// ------------------------------------------------------------
// 5. BILLING
// ------------------------------------------------------------

model Plan {
  id            Int           @id @default(autoincrement())
  name          String        @unique @db.VarChar(50)
  price         Decimal       @default(0) @db.Decimal(10, 2)
  billingCycle  BillingCycle  @default(monthly) @map("billing_cycle")
  maxBranches   Int?          @map("max_branches")
  maxUsers      Int?          @map("max_users")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  features            SubscriptionFeature[]
  subscriptions        Subscription[]
  oldPlanTransactions  SubscriptionTransaction[] @relation("OldPlan")
  newPlanTransactions  SubscriptionTransaction[] @relation("NewPlan")

  @@map("plans")
}

enum BillingCycle {
  monthly
  yearly
}

model SubscriptionFeature {
  id            Int    @id @default(autoincrement())
  planId        Int    @map("plan_id")
  featureKey    String @map("feature_key") @db.VarChar(100)
  featureValue  String @map("feature_value") @db.VarChar(255)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey], name: "uq_plan_feature")
  @@map("subscription_features")
}

model Subscription {
  id             BigInt   @id @default(autoincrement())
  organizationId BigInt   @map("organization_id")
  planId         Int      @map("plan_id")
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  status         SubStatus @default(trial)
  autoRenew      Boolean  @default(true) @map("auto_renew")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan                      @relation(fields: [planId], references: [id])
  payments     Payment[]
  transactions SubscriptionTransaction[]

  @@index([organizationId, status])
  @@map("subscriptions")
}

enum SubStatus {
  trial
  active
  expired
  cancelled
}

model Payment {
  id                BigInt        @id @default(autoincrement())
  uuid              String        @unique @db.Char(36)
  organizationId    BigInt        @map("organization_id")
  subscriptionId    BigInt?       @map("subscription_id")
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("GHS") @db.VarChar(10)
  gateway           String        @default("paystack") @db.VarChar(50)
  gatewayReference  String        @unique @map("gateway_reference") @db.VarChar(150)
  status            PaymentStatus @default(pending)
  paidAt            DateTime?     @map("paid_at")
  deletedAt         DateTime?     @map("deleted_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription?             @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  transactions SubscriptionTransaction[]

  @@index([organizationId, status])
  @@map("payments")
}

enum PaymentStatus {
  pending
  successful
  failed
}

model SubscriptionTransaction {
  id               BigInt          @id @default(autoincrement())
  subscriptionId   BigInt          @map("subscription_id")
  paymentId        BigInt?         @map("payment_id")
  transactionType  TransactionType @map("transaction_type")
  oldPlanId        Int?            @map("old_plan_id")
  newPlanId        Int?            @map("new_plan_id")
  createdAt        DateTime        @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  oldPlan      Plan?        @relation("OldPlan", fields: [oldPlanId], references: [id])
  newPlan      Plan?        @relation("NewPlan", fields: [newPlanId], references: [id])

  @@map("subscription_transactions")
}

enum TransactionType {
  new
  renewal
  upgrade
  downgrade
  cancellation
}

// ------------------------------------------------------------
// 6. NOTIFICATIONS & AUDIT
// ------------------------------------------------------------

model Notification {
  id             BigInt              @id @default(autoincrement())
  organizationId BigInt?             @map("organization_id")
  recipientType  RecipientType       @map("recipient_type")
  recipientId    BigInt              @map("recipient_id")
  channel        NotificationChannel
  message        String              @db.VarChar(500)
  status         NotificationStatus  @default(pending)
  sentAt         DateTime?           @map("sent_at")
  createdAt      DateTime            @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([recipientType, recipientId])
  @@index([organizationId])
  @@map("notifications")
}

enum RecipientType {
  customer
  user
}

enum NotificationChannel {
  sms
  whatsapp
  email
}

enum NotificationStatus {
  pending
  sent
  failed
  blocked
}

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  organizationId BigInt?  @map("organization_id")
  userId         BigInt?  @map("user_id")
  action         String   @db.VarChar(100)
  entityType     String   @map("entity_type") @db.VarChar(100)
  entityId       BigInt?  @map("entity_id")
  metadata       Json?
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ------------------------------------------------------------
// Password reset + email verification — shared by BOTH identity systems
// (staff/admin `users` and self-registered `customers`), one table instead
// of two near-duplicates. Deliberately NOT a foreign key to either table —
// ownerType + ownerId is a polymorphic reference (same pattern
// Notification already uses for recipientType/recipientId), because a
// single FK column can't point at two different tables. This does mean the
// database itself won't enforce that ownerId is real; the application
// layer is responsible for that, same tradeoff Notification already made.
//
// Security properties this table exists to provide:
//   - tokenHash, never the raw token — if this table ever leaked, nobody
//     could reconstruct a usable token from it (same principle as
//     passwordHash never storing a real password).
//   - expiresAt — every token is time-boxed; expired tokens are rejected
//     even if otherwise well-formed.
//   - usedAt — makes a token single-use; once consumed, using it again is
//     rejected even if it hasn't expired yet.
model AuthToken {
  id          BigInt        @id @default(autoincrement())
  tokenHash   String        @unique @db.VarChar(64) @map("token_hash")
  type        AuthTokenType
  ownerType   AuthOwnerType @map("owner_type")
  ownerId     BigInt        @map("owner_id")
  expiresAt   DateTime      @map("expires_at")
  usedAt      DateTime?     @map("used_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([ownerType, ownerId, type])
  @@map("auth_tokens")
}

enum AuthTokenType {
  password_reset
  email_verification
}

enum AuthOwnerType {
  user
  customer
}


model OrganizationRequest {
  id                BigInt    @id @default(autoincrement())
  businessName      String    @map("business_name") @db.VarChar(150)
  ownerName         String    @map("owner_name") @db.VarChar(150)
  businessType      String    @map("business_type") @db.VarChar(100)
  phone             String    @db.VarChar(30)
  email             String    @db.VarChar(150)
  address           String?   @db.VarChar(255)
  city              String?   @db.VarChar(100)
  region            String?   @db.VarChar(100)
  numberOfBranches  Int?      @map("number_of_branches")
  additionalNotes   String?   @map("additional_notes") @db.VarChar(1000)
  status            OrgRequestStatus @default(pending)
  reviewNotes       String?   @map("review_notes") @db.VarChar(500)
  reviewedAt        DateTime? @map("reviewed_at")
  reviewedBy        BigInt?   @map("reviewed_by")
  createdOrganizationId  BigInt?       @map("created_organization_id")
  createdOrganization    Organization? @relation(fields: [createdOrganizationId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now()) @map("created_at")

  reviewer User? @relation(fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("organization_requests")
}

enum OrgRequestStatus {
  pending
  approved
  rejected
}


model StaffService {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  serviceId BigInt   @map("service_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@unique([userId, serviceId])
  @@index([userId])
  @@map("staff_services")
}



model ContactSubmission {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(150)
  email     String   @db.VarChar(150)
  phone     String?  @db.VarChar(30)
  subject   String?  @db.VarChar(200)
  message   String   @db.VarChar(2000)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([isRead])
  @@map("contact_submissions")
}

model SupportTicket {
  id             BigInt         @id @default(autoincrement())
  subject        String         @db.VarChar(200)
  status         TicketStatus   @default(open)
  fromType       TicketPartyType @map("from_type")
  fromId         BigInt         @map("from_id")
  toType         TicketToType   @map("to_type")
  organizationId BigInt?        @map("organization_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  messages     SupportMessage[]

  @@index([toType, organizationId, status])
  @@index([fromType, fromId])
  @@map("support_tickets")
}

model SupportMessage {
  id          BigInt          @id @default(autoincrement())
  ticketId    BigInt          @map("ticket_id")
  senderType  TicketPartyType @map("sender_type")
  senderId    BigInt          @map("sender_id")
  senderName  String          @map("sender_name") @db.VarChar(150)
  message     String          @db.VarChar(2000)
  createdAt   DateTime        @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

enum TicketStatus {
  open
  in_progress
  resolved
}

enum TicketPartyType {
  customer
  staff
  org_admin
  super_admin
}

enum TicketToType {
  org_admin
  super_admin
}

enum WhenFullBehaviour {
  waitlist
  reject
}
